{
  "kind": "git-tag",
  "upstream": "https://github.com/RogerNavelsaker/toolflow-mcp.git",
  "tag_regex": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
  "tag_prefix": "v",
  "version_file": "nix/package-manifest.json",
  "version_jq": ".upstream.version",
  "pinned_paths": ["bun.lock", "bun.nix"],
  "pinned_flake_regex": "bun2nix",
  "sync_script": "bash scripts/sync-from-upstream.sh"
}
